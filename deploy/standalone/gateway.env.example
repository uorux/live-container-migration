# /etc/lcm-gateway/gateway.env: identical on every gateway (the VPS boxes and the in-cluster
# VIP gateway's flags). Relays present each backend to every gateway, so the backend list must
# match everywhere or relays get "unknown backend" and retry forever.
LCM_MINECRAFT=true
LCM_BACKEND=sdfs
LCM_BACKENDS=atm9,atm10,bettermc,evolution,ob2,sb4,skies2,p2haustian,dungeonheroes,integratedmc,abyssalascent
LCM_MENU=true
LCM_MENU_TITLE="rooty.dev Minecraft"
# LCM_LABELS="atm9=All the Mods 9,atm10=All the Mods 10"
LCM_MOTD="{backend} is starting, hang tight"
LCM_HOLD_MAX=5m
# Any agent can take a wake; the one leading the LivePod controller acts. Tailnet IPs.
LCM_WAKE_URL=http://100.126.30.73:7790,http://100.103.225.29:7790,http://100.65.16.13:7790

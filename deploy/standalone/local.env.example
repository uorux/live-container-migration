# /etc/lcm-gateway/local.env: this box only.
LCM_LISTEN=127.0.0.1:25566
LCM_ACCEPT_PROXY=127.0.0.1/32
# All addresses (the tailnet address may not exist yet at boot); the unit's IPAddressAllow and
# the host firewall keep these tailnet-only.
LCM_TUNNEL_LISTEN=0.0.0.0:7000
LCM_ADMIN_LISTEN=0.0.0.0:7001
